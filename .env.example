# Server-only credentials: never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Create long, unique secrets before enabling /admin.
ADMIN_ACCESS_PASSWORD=CHANGE_THIS_TO_A_LONG_UNIQUE_PASSWORD
ADMIN_SESSION_SECRET=GENERATE_A_64_CHARACTER_RANDOM_SECRET
ANALYTICS_IP_SALT=GENERATE_A_SEPARATE_RANDOM_SECRET

# Comma-separated office / agency / VPN addresses. These visits are excluded from business reporting.
INTERNAL_IPS=