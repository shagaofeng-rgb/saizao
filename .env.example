# Server-only credentials: never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Create long, unique secrets before enabling /admin.
ADMIN_SESSION_SECRET=GENERATE_A_64_CHARACTER_RANDOM_SECRET
ADMIN_PUBLIC_URL=https://www.szxj6899.com
ANALYTICS_IP_SALT=GENERATE_A_SEPARATE_RANDOM_SECRET
SECURITY_FINGERPRINT_SECRET=GENERATE_ANOTHER_64_CHARACTER_RANDOM_SECRET

# Optional email notification. Enquiries remain stored if delivery is unavailable.
RESEND_API_KEY=
ENQUIRY_NOTIFICATION_TO=
ENQUIRY_NOTIFICATION_FROM=
ADMIN_RECOVERY_FROM=

# Comma-separated office / agency / VPN addresses. These visits are excluded from business reporting.
INTERNAL_IPS=

# Google reporting is server-only. Paste the complete service-account JSON into Vercel,
# never a NEXT_PUBLIC_ variable or a committed env file.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SEARCH_CONSOLE_SITE_URL=https://www.szxj6899.com/
# Optional: the numeric GA4 property ID. Leave blank to keep GA4 reporting disabled.
GOOGLE_ANALYTICS_PROPERTY_ID=
